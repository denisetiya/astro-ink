---
import Base from "../../layouts/Base.astro";
import { Paper } from "astro-ink";
---
<Base title="Paper">
  <div class="docs-page">
    <h1>Paper</h1>
    <p class="docs-lede">
      A surface with intent: flat, lifted, or commanding. Elevation is a
      hierarchy tool, not a default.
    </p>

    <h2>Elevations</h2>
    <div class="docs-example">
      <Paper elevation={0}>Flat</Paper>
      <Paper elevation={1}>Lifted</Paper>
      <Paper elevation={2}>Commanding</Paper>
    </div>
    <pre class="docs-code"><code>&lt;Paper elevation=&#123;0&#125;&gt;Flat&lt;/Paper&gt;
&lt;Paper elevation=&#123;1&#125;&gt;Lifted&lt;/Paper&gt;
&lt;Paper elevation=&#123;2&#125;&gt;Commanding&lt;/Paper&gt;</code></pre>

    <h2>Square and padding</h2>
    <div class="docs-example">
      <Paper square padding="sm">Square, tight</Paper>
      <Paper padding="lg">Roomy</Paper>
    </div>
    <pre class="docs-code"><code>&lt;Paper square padding="sm"&gt;Square, tight&lt;/Paper&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>elevation</code></td><td><code>0 | 1 | 2</code></td><td><code>1</code></td><td>Shadow level.</td></tr>
        <tr><td><code>padding</code></td><td><code>none | sm | md | lg</code></td><td><code>md</code></td><td>Inner spacing.</td></tr>
        <tr><td><code>square</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Sharp corners.</td></tr>
      </tbody>
    </table>

    <h2>Theming</h2>
    <pre class="docs-code"><code>:root &#123;
  --ink-paper-bg: #ffffff;
  --ink-paper-radius: 0.625rem;
&#125;</code></pre>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Pure surface, no semantics: headings and landmarks inside stay yours.</li>
      <li>Most content sits flat; reserve elevation for what truly floats.</li>
    </ul>
  </div>
</Base>
