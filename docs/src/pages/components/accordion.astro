---
import Base from "../../layouts/Base.astro";
import { Accordion, AccordionItem } from "astro-ink";
---
<Base title="Accordion">
  <div class="docs-page">
    <h1>Accordion</h1>
    <p class="docs-lede">
      Stacked sections that open independently, or one at a time in exclusive
      mode. Buttons and regions, nothing fancy.
    </p>

    <h2>Multiple open</h2>
    <div class="docs-example" style="display: grid;" id="demo-multi">
      <Accordion>
        <AccordionItem id="acc-faq-1" title="How does theming work?">
          <p>Every visual decision reads a CSS custom property.</p>
        </AccordionItem>
        <AccordionItem id="acc-faq-2" title="Is JavaScript required?">
          <p>Reading, no. Interactive controls ship their own script only when used.</p>
        </AccordionItem>
      </Accordion>
    </div>

    <h2>Exclusive</h2>
    <div class="docs-example" style="display: grid;" id="demo-exclusive">
      <Accordion exclusive>
        <AccordionItem id="acc-ship" title="Shipping options">
          <p>Standard (3 days), express (1 day), or pickup.</p>
        </AccordionItem>
        <AccordionItem id="acc-returns" title="Returns">
          <p>30 days, no questions, prepaid label included.</p>
        </AccordionItem>
      </Accordion>
    </div>
    <pre class="docs-code"><code>&lt;Accordion exclusive&gt;
  &lt;AccordionItem id="acc-ship" title="Shipping options"&gt;
    &lt;p&gt;Standard, express, or pickup.&lt;/p&gt;
  &lt;/AccordionItem&gt;
  ...
&lt;/Accordion&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>exclusive</code> (Accordion)</td><td><code>boolean</code></td><td><code>false</code></td><td>One open at a time.</td></tr>
        <tr><td><code>id / title</code> (Item)</td><td><code>string</code></td><td>-</td><td>Wiring + trigger text.</td></tr>
        <tr><td><code>expanded</code> (Item)</td><td><code>boolean</code></td><td><code>false</code></td><td>Open on load.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Trigger is a button with <code>aria-expanded</code> and <code>aria-controls</code>; panel is a labeled region.</li>
      <li>Triggers keep their heading level (h3) for document structure.</li>
    </ul>
  </div>
</Base>
