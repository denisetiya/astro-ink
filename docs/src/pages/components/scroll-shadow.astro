---
import Base from "../../layouts/Base.astro";
import { ScrollShadow } from "astro-ink";
---
<Base title="ScrollShadow">
  <div class="docs-page">
    <h1>ScrollShadow</h1>
    <p class="docs-lede">
      ScrollArea with a conscience: edge fades show when there is more to
      read, and vanish at the ends.
    </p>

    <h2>Example</h2>
    <div class="docs-example" style="display: grid;">
      <ScrollShadow maxHeight="10rem">
        <p>Line one. Terms of service, condensed.</p>
        <p>Line two. You grant us nothing and we take nothing.</p>
        <p>Line three. Data stays in your account.</p>
        <p>Line four. Export anytime, in open formats.</p>
        <p>Line five. Delete means delete, within 30 days.</p>
        <p>Line six. Questions go to support, answered by humans.</p>
        <p>Line seven. That is the whole agreement.</p>
      </ScrollShadow>
    </div>
    <pre class="docs-code"><code>&lt;ScrollShadow maxHeight="10rem"&gt;
  &lt;p&gt;Line one...&lt;/p&gt;
  ...
&lt;/ScrollShadow&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>maxHeight</code></td><td><code>string</code></td><td><code>16rem</code></td><td>Cap before scrolling.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Shadows are pure decoration (<code>::before/::after</code>, pointer-events none).</li>
      <li>Same keyboard contract as ScrollArea.</li>
    </ul>
  </div>
</Base>
