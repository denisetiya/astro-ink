---
import Base from "../../layouts/Base.astro";
import { Button, Card } from "astro-ink";
---
<Base title="Card">
  <div class="docs-page">
    <h1>Card</h1>
    <p class="docs-lede">
      A content tile with optional media, header, body, and actions. One
      pattern, four honest slots.
    </p>

    <h2>Example</h2>
    <div class="docs-example" style="display: grid;">
      <Card>
        <div slot="media" style="height: 6rem; display: grid; place-content: center; background: color-mix(in srgb, var(--ink-accent) 15%, var(--ink-surface)); color: var(--ink-muted); font-size: var(--ink-text-sm);">Cover art</div>
        <h3 slot="header">Field guide</h3>
        <p style="font-size: var(--ink-text-sm); color: var(--ink-muted);">Twelve chapters on building interfaces that earn trust.</p>
        <Button slot="actions" href="/guides/theming">Read chapter</Button>
      </Card>
    </div>
    <pre class="docs-code"><code>&lt;Card&gt;
  &lt;div slot="media"&gt;...&lt;/div&gt;
  &lt;h3 slot="header"&gt;Field guide&lt;/h3&gt;
  &lt;p&gt;Twelve chapters...&lt;/p&gt;
  &lt;Button slot="actions" href="/guides/theming"&gt;Read chapter&lt;/Button&gt;
&lt;/Card&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>elevation</code></td><td><code>0 | 1 | 2</code></td><td><code>1</code></td><td>Shadow level.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Card is an <code>article</code>; headers inside keep real heading levels.</li>
      <li>Media slot shows labeled blocks in docs, your photos in production (with alt text).</li>
    </ul>
  </div>
</Base>
