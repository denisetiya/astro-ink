---
import Base from "../../layouts/Base.astro";
import { NumberInput } from "astro-ink";
---
<Base title="NumberInput">
  <div class="docs-page">
    <h1>NumberInput</h1>
    <p class="docs-lede">
      Numeric input with native spinners, decimal keyboard on mobile, and
      min/max/step validation.
    </p>

    <h2>Example</h2>
    <div class="docs-example">
      <span class="docs-example-label" aria-hidden="true">Example</span>
      <NumberInput id="seats" label="Seats" min={1} max={99} step={1} value="5" hint="1 to 99 seats." />
    </div>
    <pre class="docs-code"><code>&lt;NumberInput id="seats" label="Seats" min="1" max="99" step="1" value="5" /&gt;</code></pre>

    <h2>Sizes</h2>
    <div class="docs-example">
      <span class="docs-example-label" aria-hidden="true">Sizes</span>
      <NumberInput id="seats-sm" label="Small" size="sm" value="1" />
      <NumberInput id="seats-lg" label="Large" size="lg" value="99" />
    </div>
    <pre class="docs-code"><code>&lt;NumberInput id="seats-sm" label="Small" size="sm" /&gt;
&lt;NumberInput id="seats-lg" label="Large" size="lg" /&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>min / max / step</code></td><td><code>number</code></td><td>-</td><td>Native range constraints.</td></tr>
        <tr><td><code>value</code></td><td><code>string</code></td><td>-</td><td>Initial value.</td></tr>
        <tr><td colspan="4">Plus the full TextField API.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Arrow keys change the value natively.</li>
      <li>Label and messages wired like TextField.</li>
    </ul>
  </div>
</Base>
