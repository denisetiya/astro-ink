---
import Base from "../../layouts/Base.astro";
import { PasswordInput } from "astro-ink";
---
<Base title="PasswordInput">
  <div class="docs-page">
    <h1>PasswordInput</h1>
    <p class="docs-lede">
      Password field with a show/hide toggle. The toggle is a real button with
      state, not a decoration.
    </p>

    <h2>Example</h2>
    <div class="docs-example">
      <PasswordInput id="pwd" label="Password" autocomplete="new-password" hint="At least 12 characters." />
    </div>
    <pre class="docs-code"><code>&lt;PasswordInput
  id="pwd"
  label="Password"
  autocomplete="new-password"
  hint="At least 12 characters."
/&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>autocomplete</code></td><td><code>string</code></td><td><code>current-password</code></td><td>Use <code>new-password</code> for signup.</td></tr>
        <tr><td colspan="4">Plus the full TextField API.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li>Toggle is keyboard operable with <code>aria-pressed</code>.</li>
      <li><code>aria-label</code> swaps between Show/Hide password.</li>
    </ul>
  </div>
</Base>
