---
import Base from "../../layouts/Base.astro";
import { Banner } from "astro-ink";
---
<Base title="Banner">
  <div class="docs-page">
    <h1>Banner</h1>
    <p class="docs-lede">
      A full-width strip announcement. Dismissible ones leave with an event,
      not silence.
    </p>

    <h2>Example</h2>
    <div class="docs-example" style="display: grid;">
      <span class="docs-example-label" aria-hidden="true">Example</span>
      <Banner variant="info" dismissLabel="Dismiss notice">
        Maintenance this Sunday, 02:00 to 04:00 UTC. Expect short downtime.
      </Banner>
    </div>
    <pre class="docs-code"><code>&lt;Banner variant="info" dismissLabel="Dismiss notice"&gt;
  Maintenance this Sunday, 02:00 to 04:00 UTC.
&lt;/Banner&gt;</code></pre>

    <h2>Props</h2>
    <table class="docs-table">
      <thead>
        <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>variant</code></td><td><code>info | success | warning | danger</code></td><td><code>info</code></td><td>Background tint.</td></tr>
        <tr><td><code>dismissLabel</code></td><td><code>string</code></td><td>-</td><td>Shows the close button; fires <code>ink:banner:dismiss</code>.</td></tr>
      </tbody>
    </table>

    <h2>Accessibility</h2>
    <ul class="docs-list">
      <li><code>role="status"</code> announces the message politely.</li>
      <li>Close button is 44px with a real label.</li>
    </ul>
  </div>
</Base>
