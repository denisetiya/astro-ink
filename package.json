{
  "name": "astro-ink",
  "version": "0.1.0",
  "description": "Lightweight, token-driven UI components for Astro. Server-rendered, zero dependencies, fully themeable.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./themes/*": "./src/styles/themes/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "test": "vitest run",
    "docs:dev": "npm run dev --workspace docs",
    "docs:build": "npm run build --workspace docs",
    "docs:preview": "npm run preview --workspace docs",
    "check": "npm run check --workspace docs"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
