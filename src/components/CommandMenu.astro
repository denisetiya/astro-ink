---
interface Props {
  items: Array<{ label: string; href: string; hint?: string }>;
  placeholder?: string;
  label?: string;
  class?: string;
}

const { items, placeholder = "Type a command…", label = "Command menu", class: className, ...rest } = Astro.props;
---
<div class:list={["ink-command", className]} data-ink-command {...rest}>
  <button
    type="button"
    class="ink-command__trigger"
    data-ink-command-trigger
    aria-haspopup="dialog"
    aria-label={`Open ${label.toLowerCase()}`}
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <span class="ink-command__trigger-text">Search</span>
    <kbd class="ink-command__kbd">Ctrl K</kbd>
  </button>

  <div class="ink-command__backdrop" data-ink-command-backdrop hidden></div>
  <div
    class="ink-command__dialog"
    role="dialog"
    aria-modal="true"
    aria-label={label}
    data-ink-command-dialog
    hidden
  >
    <input
      type="text"
      role="combobox"
      class="ink-command__input"
      placeholder={placeholder}
      aria-label="Filter commands"
      aria-expanded="true"
      aria-controls="ink-command-list"
      aria-autocomplete="list"
      autocomplete="off"
      data-ink-command-input
    />
    <ul class="ink-command__list" role="listbox" id="ink-command-list" aria-label="Results" data-ink-command-list>
      {items.map((item, i) => (
        <li
          role="option"
          id={`ink-cmd-${i}`}
          class="ink-command__option"
          data-href={item.href}
          data-search={`${item.label} ${item.hint ?? ""}`.toLowerCase()}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={-1}
        >
          <span class="ink-command__label">{item.label}</span>
          {item.hint && <span class="ink-command__hint">{item.hint}</span>}
        </li>
      ))}
    </ul>
    <p class="ink-command__empty" data-ink-command-empty hidden>No results. Try a different search.</p>
  </div>
</div>

<style>
  .ink-command {
    display: inline-block;
  }

  .ink-command__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--ink-space-2);
    min-height: 2.75rem;
    padding: var(--ink-space-2) var(--ink-space-3);
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-md);
    background: var(--ink-surface);
    color: var(--ink-muted);
    font-size: var(--ink-text-sm);
    cursor: pointer;
  }

  .ink-command__trigger:hover {
    border-color: var(--ink-ink);
    color: var(--ink-ink);
  }

  .ink-command__kbd {
    font-family: var(--ink-font-mono);
    font-size: var(--ink-text-xs);
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-sm);
    padding: 1px var(--ink-space-1);
  }

  .ink-command__backdrop {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.35);
    z-index: var(--ink-z-overlay, 100);
  }

  .ink-command__backdrop[hidden] { display: none; }

  .ink-command__dialog {
    position: fixed;
    top: 15vh;
    left: 50%;
    translate: -50% 0;
    width: min(36rem, calc(100vw - 2rem));
    max-height: 60vh;
    overflow: auto;
    background: var(--ink-surface);
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-lg);
    box-shadow: var(--ink-shadow-2);
    z-index: var(--ink-z-modal, 200);
  }

  .ink-command__dialog[hidden] { display: none; }

  .ink-command__input {
    width: 100%;
    padding: var(--ink-space-3) var(--ink-space-4);
    border: none;
    border-bottom: 1px solid var(--ink-border);
    background: transparent;
    font-size: var(--ink-text-base);
    color: var(--ink-ink);
  }

  .ink-command__input:focus { outline: none; }

  .ink-command__list {
    list-style: none;
    padding: var(--ink-space-1);
    margin: 0;
    display: grid;
  }

  .ink-command__option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ink-space-3);
    padding: var(--ink-space-2) var(--ink-space-3);
    min-height: 2.75rem;
    border-radius: var(--ink-radius-sm);
    font-size: var(--ink-text-sm);
    cursor: pointer;
  }

  .ink-command__option[aria-selected="true"] {
    background: color-mix(in srgb, var(--ink-accent) 12%, transparent);
  }

  .ink-command__option[hidden] { display: none; }

  .ink-command__hint {
    color: var(--ink-muted);
    font-size: var(--ink-text-xs);
  }

  .ink-command__empty {
    padding: var(--ink-space-4);
    color: var(--ink-muted);
    font-size: var(--ink-text-sm);
    text-align: center;
  }

  .ink-command__empty[hidden] { display: none; }
</style>

<script>
  function initCommands(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-ink-command]").forEach((cmd) => {
      if (cmd.dataset.inkBound) return;
      cmd.dataset.inkBound = "true";
      const trigger = cmd.querySelector<HTMLElement>("[data-ink-command-trigger]");
      const backdrop = cmd.querySelector<HTMLElement>("[data-ink-command-backdrop]");
      const dialog = cmd.querySelector<HTMLElement>("[data-ink-command-dialog]");
      const input = cmd.querySelector<HTMLInputElement>("[data-ink-command-input]");
      const list = cmd.querySelector<HTMLElement>("[data-ink-command-list]");
      const empty = cmd.querySelector<HTMLElement>("[data-ink-command-empty]");
      if (!trigger || !backdrop || !dialog || !input || !list || !empty) return;

      const options = () =>
        Array.from(list.querySelectorAll<HTMLElement>('[role="option"]:not([hidden])'));

      const setActive = (el: HTMLElement | null) => {
        for (const opt of list.querySelectorAll<HTMLElement>('[role="option"]')) {
          opt.setAttribute("aria-selected", opt === el ? "true" : "false");
        }
        input.setAttribute("aria-activedescendant", el?.id ?? "");
      };

      const filter = () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const opt of list.querySelectorAll<HTMLElement>('[role="option"]')) {
          const hit = !q || (opt.dataset.search ?? "").includes(q);
          opt.hidden = !hit;
          if (hit) visible++;
        }
        empty.hidden = visible > 0;
        setActive(options()[0] ?? null);
      };

      const open = () => {
        backdrop.hidden = false;
        dialog.hidden = false;
        input.value = "";
        filter();
        input.focus();
      };
      const close = () => {
        backdrop.hidden = true;
        dialog.hidden = true;
        trigger.focus();
      };

      trigger.addEventListener("click", open);
      backdrop.addEventListener("click", close);
      input.addEventListener("input", filter);
      input.addEventListener("keydown", (event: KeyboardEvent) => {
        const opts = options();
        const at = opts.findIndex((o) => o.getAttribute("aria-selected") === "true");
        if (event.key === "Escape") {
          event.preventDefault();
          close();
        } else if (event.key === "ArrowDown") {
          event.preventDefault();
          const next = opts[(at + 1) % opts.length];
          if (next) setActive(next);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          const prev = opts[(at - 1 + opts.length) % opts.length];
          if (prev) setActive(prev);
        } else if (event.key === "Home") {
          event.preventDefault();
          if (opts[0]) setActive(opts[0]);
        } else if (event.key === "End") {
          event.preventDefault();
          if (opts[opts.length - 1]) setActive(opts[opts.length - 1]);
        } else if (event.key === "Enter") {
          const active = opts.find((o) => o.getAttribute("aria-selected") === "true");
          const href = active?.dataset.href;
          if (href) window.location.href = href;
        }
      });
      list.addEventListener("click", (event: Event) => {
        const el = event.target as HTMLElement;
        const opt = el.closest?.('[role="option"]') as HTMLElement | null;
        const href = opt?.dataset.href;
        if (href) window.location.href = href;
      });

      document.addEventListener("keydown", (event: KeyboardEvent) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (dialog.hidden) open();
          else close();
        }
      });
    });
  }

  initCommands();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = { init: (root?: ParentNode) => { prev?.(root); initCommands(root ?? document); } };
</script>
