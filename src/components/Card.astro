---
interface Props {
  elevation?: 0 | 1 | 2;
  orientation?: "vertical" | "horizontal";
  padding?: "sm" | "md" | "lg";
  class?: string;
}

const { elevation = 1, orientation = "vertical", padding = "md", class: className, ...rest } = Astro.props;
---
<article
  class:list={[
    "ink-card",
    `ink-card--e${elevation}`,
    `ink-card--${orientation}`,
    `ink-card--pad-${padding}`,
    className,
  ]}
  {...rest}
>
  <slot name="media" />
  <div class="ink-card__body">
    <slot name="header" />
    <div class="ink-card__content"><slot /></div>
    <div class="ink-card__actions"><slot name="actions" /></div>
  </div>
</article>

<style>
  .ink-card {
    background: var(--ink-surface);
    border: 1px solid var(--ink-border);
    border-radius: var(--ink-radius-lg);
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }

  .ink-card--e0 { box-shadow: none; }
  .ink-card--e1 { box-shadow: var(--ink-shadow-1); }
  .ink-card--e2 { box-shadow: var(--ink-shadow-2); }

  .ink-card__body {
    display: grid;
    gap: var(--ink-space-2);
    padding: var(--ink-space-4);
    min-width: 0;
  }

  .ink-card--pad-sm .ink-card__body { padding: var(--ink-space-3); }
  .ink-card--pad-lg .ink-card__body { padding: var(--ink-space-6); }

  .ink-card--horizontal {
    display: grid;
    grid-template-columns: auto 1fr;
  }

  .ink-card--horizontal > :global([slot="media"]) {
    min-height: 100%;
  }

  .ink-card--horizontal .ink-card__body {
    align-content: start;
  }

  @media (max-width: 28rem) {
    .ink-card--horizontal {
      grid-template-columns: 1fr;
    }
  }

  .ink-card__actions {
    display: flex;
    gap: var(--ink-space-2);
    flex-wrap: wrap;
    margin-top: var(--ink-space-1);
  }

  .ink-card__actions:empty { display: none; }
</style>
