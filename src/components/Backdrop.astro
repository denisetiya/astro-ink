---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className, ...rest } = Astro.props;
---
<div id={id} class:list={["ink-backdrop", className]} aria-hidden="true" data-ink-backdrop {...rest}>
</div>

<style>
  .ink-backdrop {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.35);
    z-index: var(--ink-z-overlay, 100);
  }

  .ink-backdrop[hidden] { display: none; }
</style>
