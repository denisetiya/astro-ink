---
interface Props {
  items: Array<{ label: string; href: string; iconSvg?: string }>;
  current: string;
  label?: string;
  class?: string;
}

const { items, current, label = "Primary", class: className, ...rest } = Astro.props;
---
<nav aria-label={label} class:list={["ink-bottom", className]} {...rest}>
  <ul class="ink-bottom__list">
    {items.map((item) => (
      <li class="ink-bottom__item">
        <a
          class="ink-bottom__link"
          href={item.href}
          aria-current={item.href === current ? "page" : undefined}
        >
          {item.iconSvg && <span class="ink-bottom__icon" aria-hidden="true" set:html={item.iconSvg} />}
          <span class="ink-bottom__label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .ink-bottom {
    border-top: 1px solid var(--ink-border);
    background: var(--ink-surface);
  }

  .ink-bottom__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ink-bottom__item { flex: 1; }

  .ink-bottom__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-height: 3.5rem;
    padding: var(--ink-space-2) var(--ink-space-1);
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--ink-text-xs);
  }

  .ink-bottom__link[aria-current="page"] {
    color: var(--ink-accent);
    font-weight: var(--ink-font-weight-medium);
  }

  .ink-bottom__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .ink-bottom__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
