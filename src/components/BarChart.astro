---
import { scaleLinear, niceTicks } from "../scripts/chart";

interface ChartPoint {
  label: string;
  value: number;
}

interface Props {
  data: ChartPoint[];
  width?: number;
  height?: number;
  label?: string;
  showValues?: boolean;
  layout?: "vertical";
  class?: string;
}

const {
  data,
  width = 560,
  height = 240,
  label = "Bar chart",
  showValues = false,
  layout = "vertical",
  class: className,
  ...rest
} = Astro.props;

const padL = 44;
const padR = 12;
const padT = showValues ? 18 : 10;
const padB = 28;
const iw = Math.max(1, width - padL - padR);
const ih = Math.max(1, height - padT - padB);

const values = data.map((d) => d.value);
const dMin = values.length > 0 ? Math.min(0, ...values) : 0;
const dMax = values.length > 0 ? Math.max(0, ...values) : 1;
const ticks = niceTicks(dMin, dMax, 4);
let tMin = ticks.length > 0 ? ticks[0] : dMin;
let tMax = ticks.length > 0 ? ticks[ticks.length - 1] : dMax;
if (tMax <= tMin) tMax = tMin + 1;

const y = scaleLinear(tMin, tMax, padT + ih, padT);
const zeroY = Math.min(padT + ih, Math.max(padT, y(0)));

const slotW = data.length > 0 ? iw / data.length : iw;
const barW = Math.min(48, Math.max(8, slotW * 0.6));
const bars = data.map((d, i) => {
  const cx = padL + slotW * (i + 0.5);
  const vy = y(d.value);
  return {
    label: d.label,
    value: d.value,
    x: cx - barW / 2,
    y: Math.min(vy, zeroY),
    h: Math.max(0, Math.abs(vy - zeroY)),
    cx,
  };
});

let summary = `${label}, 0 points`;
if (bars.length > 0) {
  let hi = bars[0];
  let lo = bars[0];
  for (const b of bars) {
    if (b.value > hi.value) hi = b;
    if (b.value < lo.value) lo = b;
  }
  summary = `${label}, ${bars.length} points, high ${hi.label} ${hi.value}, low ${lo.label} ${lo.value}`;
}

const slug = label
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");
const titleId = `ink-bar-${slug || "chart"}-title`;
const descId = `ink-bar-${slug || "chart"}-desc`;
const trunc = (s: string) => (s.length > 8 ? `${s.slice(0, 8)}…` : s);
---
<div class:list={["ink-bar", className]} data-layout={layout}>
  <svg
    class="ink-bar__svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={summary}
    {...rest}
  >
    <title id={titleId}>{summary}</title>
    <desc id={descId}>{`Static vertical bar chart of ${label}. Values read left to right.`}</desc>
    {ticks.map((t) => (
      <g>
        <line class="ink-bar__grid" x1={padL} x2={padL + iw} y1={y(t)} y2={y(t)} />
        <text class="ink-bar__tick" x={padL - 6} y={y(t)} text-anchor="end" dominant-baseline="central">{t}</text>
      </g>
    ))}
    <line class="ink-bar__baseline" x1={padL} x2={padL + iw} y1={zeroY} y2={zeroY} />
    {bars.map((b) => (
      <rect class="ink-bar__bar" data-ink-bar x={b.x} y={b.y} width={barW} height={Math.max(b.h, 0.5)} rx="2">
        <title>{`${b.label}: ${b.value}`}</title>
      </rect>
    ))}
    {bars.map((b) => (
      <text class="ink-bar__xlabel" x={b.cx} y={height - 8} text-anchor="middle">
        <title>{b.label}</title>{trunc(b.label)}
      </text>
    ))}
    {showValues &&
      bars.map((b) => (
        <text class="ink-bar__value" x={b.cx} y={b.y - 5} text-anchor="middle">{b.value}</text>
      ))}
  </svg>
</div>

<style>
  .ink-bar {
    --ink-barchart-accent: var(--ink-accent);
    --ink-barchart-grid: var(--ink-border);
    --ink-barchart-tick: var(--ink-muted);
  }

  .ink-bar__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: inherit;
  }

  .ink-bar__grid,
  .ink-bar__baseline {
    stroke: var(--ink-barchart-grid);
    stroke-width: 1;
  }

  .ink-bar__tick,
  .ink-bar__xlabel,
  .ink-bar__value {
    fill: var(--ink-barchart-tick);
    font-size: var(--ink-text-xs);
  }

  .ink-bar__bar {
    fill: var(--ink-barchart-accent);
  }

  .ink-bar__bar:hover {
    filter: brightness(0.85);
  }
</style>
