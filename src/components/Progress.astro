---
interface Props {
  value?: number;
  max?: number;
  label: string;
  showValue?: boolean;
  size?: "sm" | "md" | "lg";
  tone?: "accent" | "success" | "warning" | "danger";
  class?: string;
}

const { value, max = 100, label, showValue = false, size = "md", tone = "accent", class: className, ...rest } = Astro.props;
const pct = value === undefined ? undefined : Math.min(100, Math.max(0, (value / max) * 100));
const now = pct === undefined ? undefined : Math.round(((pct ?? 0) / 100) * max);
---
<div class:list={["ink-progress", `ink-progress--${size}`, className]}>
  <div
    class="ink-progress__track"
    role="progressbar"
    aria-label={label}
    aria-valuemin={0}
    aria-valuemax={max}
    aria-valuenow={now}
    {...rest}
  >
    <div
      class:list={["ink-progress__fill", `ink-progress__fill--${tone}`, value === undefined && "ink-progress__fill--indeterminate"]}
      style={pct === undefined ? undefined : `width: ${pct}%`}
    ></div>
  </div>
  {showValue && pct !== undefined && <span class="ink-progress__value">{Math.round(pct)}%</span>}
</div>

<style>
  .ink-progress {
    display: flex;
    align-items: center;
    gap: var(--ink-space-3);
  }

  .ink-progress__track {
    flex: 1;
    height: var(--ink-progress-height, 0.5rem);
    border-radius: var(--ink-progress-radius, 999px);
    background: color-mix(in srgb, var(--ink-ink) 12%, var(--ink-bg));
    overflow: hidden;
  }

  .ink-progress__fill {
    height: 100%;
    background: var(--ink-accent);
    border-radius: var(--ink-progress-radius, 999px);
    transition: width var(--ink-duration-base) var(--ink-ease);
  }

  .ink-progress__fill--indeterminate {
    width: 35%;
    animation: ink-progress-slide 1.2s ease-in-out infinite;
  }

  .ink-progress--sm .ink-progress__track { height: 0.375rem; }
  .ink-progress--lg .ink-progress__track { height: 0.75rem; }

  .ink-progress__fill--success { background: var(--ink-success); }
  .ink-progress__fill--warning { background: var(--ink-warning); }
  .ink-progress__fill--danger { background: var(--ink-danger); }

  @keyframes ink-progress-slide {
    0% { margin-inline-start: -35%; }
    100% { margin-inline-start: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-progress__fill--indeterminate {
      animation: none;
      width: 100%;
    }
  }

  .ink-progress__value {
    font-size: var(--ink-text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }
</style>
