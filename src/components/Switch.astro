---
interface Props {
  name: string;
  label?: string;
  checked?: boolean;
  disabled?: boolean;
  class?: string;
}

const { name, label, checked = false, disabled = false, class: className, ...rest } = Astro.props;
---
<label class:list={["ink-switch", className]}>
  <input type="checkbox" role="switch" class="ink-switch__input" name={name} checked={checked || undefined} disabled={disabled || undefined} {...rest} />
  <span class="ink-switch__track" aria-hidden="true">
    <span class="ink-switch__thumb"></span>
  </span>
  <span class="ink-switch__label"><slot>{label}</slot></span>
</label>

<style>
  .ink-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--ink-space-2);
    cursor: pointer;
    font-size: var(--ink-text-sm);
  }

  .ink-switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .ink-switch__track {
    width: 2.5rem;
    height: 1.375rem;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--ink-border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink-ink) 22%, var(--ink-bg));
    transition:
      background-color var(--ink-duration-base) var(--ink-ease),
      border-color var(--ink-duration-base) var(--ink-ease);
  }

  .ink-switch__thumb {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--ink-surface);
    box-shadow: var(--ink-shadow-1);
    transition: translate var(--ink-duration-base) var(--ink-ease);
  }

  .ink-switch__input:checked + .ink-switch__track {
    background: var(--ink-accent);
    border-color: var(--ink-accent);
  }

  .ink-switch__input:checked + .ink-switch__track .ink-switch__thumb {
    translate: 1.125rem 0;
  }

  .ink-switch__input:focus-visible + .ink-switch__track {
    outline: 2px solid var(--ink-focus-color);
    outline-offset: 2px;
  }

  .ink-switch__input:disabled + .ink-switch__track {
    opacity: 0.5;
  }

  .ink-switch:has(.ink-switch__input:disabled) {
    cursor: not-allowed;
  }
</style>
