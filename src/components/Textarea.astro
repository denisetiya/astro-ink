---
import Field from "./Field.astro";

interface Props {
  id: string;
  label: string;
  name?: string;
  rows?: number;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  placeholder?: string;
  autosize?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  id, label, name = id, rows = 4, hint, error, required = false,
  disabled = false, readonly = false, placeholder, autosize = false,
  size = "md", class: className, ...rest
} = Astro.props;

const describedBy = [hint && `${id}-hint`, error && `${id}-error`]
  .filter(Boolean)
  .join(" ") || undefined;
---
<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <textarea
    id={id}
    name={name}
    rows={rows}
    class:list={["ink-textarea", size !== "md" && `ink-textarea--${size}`]}
    placeholder={placeholder}
    required={required || undefined}
    disabled={disabled || undefined}
    readonly={readonly || undefined}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    data-ink-autosize={autosize ? "" : undefined}
    {...rest}
  ><slot /></textarea>
</Field>

<script>
  import { autosize } from "../scripts/autosize";

  function initTextareas(root: ParentNode = document) {
    root.querySelectorAll<HTMLTextAreaElement>("[data-ink-autosize]").forEach((el) => {
      if (el.dataset.inkBound) return;
      el.dataset.inkBound = "true";
      autosize(el);
    });
  }

  initTextareas();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = { init: (root?: ParentNode) => { prev?.(root); initTextareas(root ?? document); } };
</script>
