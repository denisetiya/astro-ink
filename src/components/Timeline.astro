---
interface Props {
  align?: "left" | "alternate";
  label?: string;
  class?: string;
}

const { align = "left", label, class: className, ...rest } = Astro.props;
---
<ul class:list={["ink-timeline", `ink-timeline--${align}`, className]} aria-label={label} {...rest}>
  <slot />
</ul>

<style>
  .ink-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--ink-space-4);
    position: relative;
  }

  .ink-timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    inset-inline-start: 0.4375rem;
    border-inline-start: 2px solid var(--ink-border-strong);
  }
</style>
