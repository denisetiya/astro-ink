---
interface Props {
  title: string;
  description?: string;
  level?: 1 | 2;
  class?: string;
}

const { title, description, level = 1, class: className, ...rest } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---
<div class:list={["ink-pagehead", className]} {...rest}>
  <div class="ink-pagehead__text">
    <Tag class="ink-pagehead__title">{title}</Tag>
    {description && <p class="ink-pagehead__desc">{description}</p>}
  </div>
  <div class="ink-pagehead__actions">
    <slot name="actions" />
  </div>
</div>

<style>
  .ink-pagehead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ink-space-3);
  }

  .ink-pagehead__title {
    font-size: var(--ink-text-2xl);
    font-weight: var(--ink-font-weight-bold);
  }

  .ink-pagehead__desc {
    margin-top: var(--ink-space-1);
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .ink-pagehead__actions {
    display: flex;
    gap: var(--ink-space-2);
    flex-wrap: wrap;
  }
</style>
