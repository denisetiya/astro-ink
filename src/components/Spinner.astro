---
interface Props {
  label?: string;
  size?: "sm" | "md";
  class?: string;
}

const { label = "Loading…", size = "md", class: className, ...rest } = Astro.props;
---
<span class:list={["ink-spinner", `ink-spinner--${size}`, className]} role="status" aria-label={label} {...rest}>
  <span class="ink-spinner__ring" aria-hidden="true"></span>
</span>

<style>
  .ink-spinner {
    display: inline-flex;
    align-items: center;
  }

  .ink-spinner__ring {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--ink-spinner-radius, 50%);
    border: 2.5px solid color-mix(in srgb, var(--ink-ink) 15%, transparent);
    border-top-color: var(--ink-accent);
    animation: ink-spin 0.8s linear infinite;
  }

  .ink-spinner--sm .ink-spinner__ring {
    width: 1rem;
    height: 1rem;
    border-width: 2px;
  }

  @keyframes ink-spin {
    to { rotate: 360deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-spinner__ring { animation-duration: 2.4s; }
  }
</style>
