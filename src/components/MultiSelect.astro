---
import Field from "./Field.astro";
import { normalizeOptions } from "../scripts/listbox";

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  id: string;
  label: string;
  name?: string;
  options: Array<string | Option>;
  values?: string[];
  placeholder?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id, label, name = id, options, values = [], placeholder,
  hint, error, required = false, disabled = false, class: className, ...rest
} = Astro.props;

const items = normalizeOptions(options);
const selected = new Set(values);
const resolvedPlaceholder = placeholder ?? `Select ${label.toLowerCase()}`;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;

// NOTE: single selection shows its label; 2+ show "N selected" (the e2e
// contract requires "2 selected" after two checks, so no joined-labels case).
const textFor = (vals: string[]) => {
  if (vals.length === 0) return resolvedPlaceholder;
  if (vals.length === 1) return items.find((o) => o.value === vals[0])?.label ?? vals[0];
  return `${vals.length} selected`;
};
const initialText = textFor(values.filter((v) => items.some((o) => o.value === v)));
---
<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <div class="ink-ms" data-ink-ms data-placeholder={resolvedPlaceholder}>
    <button
      type="button"
      class="ink-input ink-ms__trigger"
      data-ink-ms-trigger
      aria-expanded="false"
      aria-controls={`${id}-panel`}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : undefined}
      disabled={disabled || undefined}
      {...rest}
    >
      <span class="ink-visually-hidden">{label}: </span>
      <span class="ink-ms__text" data-ink-ms-text>{initialText}</span>
      <svg class="ink-ms__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="ink-ms__panel" role="group" aria-label={`${label} options`} id={`${id}-panel`} data-ink-ms-panel hidden>
      {items.map((o) => (
        <label class="ink-ms__option">
          <input
            type="checkbox"
            class="ink-ms__check"
            name={name}
            value={o.value}
            checked={selected.has(o.value) || undefined}
            disabled={disabled || o.disabled || undefined}
          />
          <span>{o.label}</span>
        </label>
      ))}
      <button type="button" class="ink-ms__clear" data-ink-ms-clear disabled={disabled || undefined}>Clear</button>
    </div>
  </div>
</Field>

<style>
  .ink-ms {
    position: relative;
  }

  .ink-ms__trigger {
    display: flex;
    align-items: center;
    gap: var(--ink-space-2);
    text-align: start;
    cursor: pointer;
  }

  .ink-ms__text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ink-ms__chevron {
    flex: none;
    color: var(--ink-muted);
  }

  .ink-ms__trigger[aria-expanded="true"] .ink-ms__chevron { rotate: 180deg; }

  .ink-ms__panel {
    position: absolute;
    top: calc(100% + var(--ink-space-1));
    inset-inline: 0;
    display: grid;
    gap: var(--ink-space-1);
    padding: var(--ink-space-2);
    background: var(--ink-surface);
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-md);
    box-shadow: var(--ink-shadow-2);
    z-index: var(--ink-z-dropdown, 50);
  }

  .ink-ms__panel[hidden] { display: none; }

  .ink-ms__option {
    display: flex;
    align-items: center;
    gap: var(--ink-space-2);
    padding: var(--ink-space-2) var(--ink-space-3);
    min-height: 2.75rem;
    border-radius: var(--ink-radius-sm);
    font-size: var(--ink-text-sm);
    color: var(--ink-ink);
    cursor: pointer;
  }

  .ink-ms__option:hover {
    background: color-mix(in srgb, var(--ink-accent) 10%, transparent);
  }

  .ink-ms__check {
    width: 1rem;
    height: 1rem;
    flex: none;
    accent-color: var(--ink-accent);
  }

  .ink-ms__clear {
    justify-self: start;
    border: none;
    background: transparent;
    color: var(--ink-accent);
    font-size: var(--ink-text-sm);
    padding: var(--ink-space-1) var(--ink-space-2);
    border-radius: var(--ink-radius-sm);
    cursor: pointer;
  }

  .ink-ms__clear:hover { text-decoration: underline; }

  .ink-ms__clear:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    text-decoration: none;
  }
</style>

<script>
  function initMultiSelects(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-ink-ms]").forEach((box) => {
      if (box.dataset.inkBound) return;
      box.dataset.inkBound = "true";
      const trigger = box.querySelector<HTMLButtonElement>("[data-ink-ms-trigger]");
      const panel = box.querySelector<HTMLElement>("[data-ink-ms-panel]");
      const text = box.querySelector<HTMLElement>("[data-ink-ms-text]");
      const clear = box.querySelector<HTMLButtonElement>("[data-ink-ms-clear]");
      if (!trigger || !panel || !text) return;
      const checks = Array.from(panel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      const placeholder = box.dataset.placeholder ?? "Select options";

      const labels = new Map<string, string>();
      panel.querySelectorAll<HTMLElement>(".ink-ms__option").forEach((opt) => {
        const input = opt.querySelector<HTMLInputElement>('input[type="checkbox"]');
        const span = opt.querySelector("span");
        if (input && span) labels.set(input.value, span.textContent ?? input.value);
      });

      const currentValues = () => checks.filter((c) => c.checked).map((c) => c.value);

      const textFor = (vals: string[]) => {
        if (vals.length === 0) return placeholder;
        if (vals.length === 1) return labels.get(vals[0]) ?? vals[0];
        return `${vals.length} selected`;
      };

      const sync = (emit: boolean) => {
        const vals = currentValues();
        text.textContent = textFor(vals);
        if (emit) box.dispatchEvent(new CustomEvent("ink:ms:change", { bubbles: true, detail: { values: vals } }));
      };

      const isOpen = () => !panel.hidden;
      const open = () => { panel.hidden = false; trigger.setAttribute("aria-expanded", "true"); };
      const close = () => { panel.hidden = true; trigger.setAttribute("aria-expanded", "false"); };

      trigger.addEventListener("click", () => { isOpen() ? close() : open(); });
      trigger.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape" && isOpen()) { event.preventDefault(); close(); }
      });
      panel.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape" && isOpen()) { event.preventDefault(); close(); trigger.focus(); }
      });

      box.addEventListener("change", () => sync(true));

      clear?.addEventListener("click", () => {
        checks.forEach((c) => { if (!c.disabled) c.checked = false; });
        sync(true);
      });

      document.addEventListener("click", (event: Event) => {
        if (!box.contains(event.target as Node)) close();
      });
    });
  }

  initMultiSelects();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = { init: (root?: ParentNode) => { prev?.(root); initMultiSelects(root ?? document); } };
</script>
