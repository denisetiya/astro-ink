---
interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  name: string;
  label: string;
  options: Array<string | Option>;
  value?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  class?: string;
}

const { name, label, options, value, hint, error, required = false, class: className, ...rest } = Astro.props;
const items: Option[] = options.map((o) => (typeof o === "string" ? { value: o, label: o } : o));
const current = value ?? items[0]?.value;
const describedBy = [hint && `${name}-hint`, error && `${name}-error`].filter(Boolean).join(" ") || undefined;
---
<fieldset class:list={["ink-segmented", className]} aria-describedby={describedBy} {...rest}>
  <legend class="ink-segmented__legend">
    {label}{required && <span class="ink-segmented__required" aria-hidden="true"> *</span>}
  </legend>
  <div class="ink-segmented__options">
    {items.map((item) => (
      <label class="ink-segmented__option">
        <input
          type="radio"
          class="ink-visually-hidden"
          name={name}
          value={item.value}
          checked={item.value === current || undefined}
          required={required || undefined}
          disabled={item.disabled || undefined}
        />
        <span class="ink-segmented__label">{item.label}</span>
      </label>
    ))}
  </div>
  {hint && <p class="ink-segmented__hint" id={`${name}-hint`}>{hint}</p>}
  {error && <p class="ink-segmented__error" id={`${name}-error`}>{error}</p>}
</fieldset>

<style>
  .ink-segmented { border: none; padding: 0; margin: 0; display: grid; gap: var(--ink-space-2); }

  .ink-segmented__legend {
    font-size: var(--ink-text-sm);
    font-weight: var(--ink-font-weight-medium);
    padding: 0;
  }

  .ink-segmented__required { color: var(--ink-danger); }

  .ink-segmented__options {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-md);
    background: color-mix(in srgb, var(--ink-ink) 4%, var(--ink-bg));
  }

  .ink-segmented__option { position: relative; flex: 1; }

  /* Stretch the native radio over its option: the wrapping label otherwise
     covers the 1px box and intercepts pointer clicks on the real input. */
  .ink-segmented__option > .ink-visually-hidden {
    width: 100%;
    height: 100%;
    inset: 0;
    margin: 0;
    clip: auto;
    opacity: 0;
    cursor: pointer;
  }

  .ink-segmented__label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding-inline: var(--ink-space-4);
    border-radius: var(--ink-radius-sm);
    font-size: var(--ink-text-sm);
    font-weight: var(--ink-font-weight-medium);
    color: var(--ink-muted);
    cursor: pointer;
    white-space: nowrap;
  }

  .ink-segmented__option > input:checked + .ink-segmented__label {
    background: var(--ink-surface);
    color: var(--ink-ink);
    box-shadow: var(--ink-shadow-1);
  }

  .ink-segmented__option > input:focus-visible + .ink-segmented__label {
    outline: 2px solid var(--ink-focus-color);
    outline-offset: 2px;
  }

  .ink-segmented__option > input:disabled + .ink-segmented__label {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ink-segmented__hint { font-size: var(--ink-text-xs); color: var(--ink-muted); }
  .ink-segmented__error { font-size: var(--ink-text-xs); color: var(--ink-danger); font-weight: var(--ink-font-weight-medium); }
</style>
