---
import Field from "./Field.astro";

interface Props {
  id: string;
  label: string;
  name?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  placeholder?: string;
  autocomplete?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  id, label, name = id, hint, error, required = false,
  disabled = false, placeholder, autocomplete = "current-password",
  size = "md", class: className, ...rest
} = Astro.props;

const describedBy = [hint && `${id}-hint`, error && `${id}-error`]
  .filter(Boolean)
  .join(" ") || undefined;
---
<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <div class="ink-password">
    <input
      id={id}
      name={name}
      type="password"
      class:list={["ink-input", size !== "md" && `ink-input--${size}`]}
      autocomplete={autocomplete}
      placeholder={placeholder}
      required={required || undefined}
      disabled={disabled || undefined}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      {...rest}
    />
    <button
      type="button"
      class="ink-password__toggle"
      data-ink-password-toggle
      aria-pressed="false"
      aria-label="Show password"
    >Show</button>
  </div>
</Field>

<style>
  .ink-password {
    position: relative;
  }

  .ink-password input {
    padding-right: 4.25rem;
  }

  .ink-password__toggle {
    position: absolute;
    right: var(--ink-space-2);
    top: 50%;
    translate: 0 -50%;
    padding: var(--ink-space-1) var(--ink-space-2);
    border: none;
    border-radius: var(--ink-radius-sm);
    background: transparent;
    color: var(--ink-accent);
    font-size: var(--ink-text-sm);
    font-weight: var(--ink-font-weight-medium);
  }

  .ink-password__toggle:hover {
    background: color-mix(in srgb, var(--ink-accent) 10%, transparent);
  }
</style>

<script>
  function initPasswordToggles(root: ParentNode = document) {
    root.querySelectorAll<HTMLButtonElement>("[data-ink-password-toggle]").forEach((btn) => {
      if (btn.dataset.inkBound) return;
      btn.dataset.inkBound = "true";
      btn.addEventListener("click", () => {
        const input = btn.parentElement?.querySelector("input");
        if (!input) return;
        const show = input.type === "password";
        input.type = show ? "text" : "password";
        btn.setAttribute("aria-pressed", String(show));
        btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
        btn.textContent = show ? "Hide" : "Show";
      });
    });
  }

  initPasswordToggles();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = {
    init: (root?: ParentNode) => {
      prev?.(root);
      initPasswordToggles(root ?? document);
    },
  };
</script>
