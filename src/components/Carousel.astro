---
interface Props {
  label?: string;
  autoplay?: boolean;
  interval?: number;
  class?: string;
}

const { label = "Carousel", autoplay = false, interval = 5000, class: className, ...rest } = Astro.props;
---
<div
  class:list={["ink-carousel", className]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-ink-carousel
  data-autoplay={autoplay ? "" : undefined}
  data-interval={interval}
  {...rest}
>
  <div class="ink-carousel__viewport" data-ink-carousel-viewport data-index={0}>
    <div class="ink-carousel__track" data-ink-carousel-track>
      <slot />
    </div>
  </div>
  <div class="ink-carousel__controls">
    <button type="button" class="ink-carousel__arrow" data-ink-carousel-prev aria-label="Previous slide">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2.5L4.5 7 9 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="ink-carousel__dots" data-ink-carousel-dots></div>
    <button type="button" class="ink-carousel__arrow" data-ink-carousel-next aria-label="Next slide">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 2.5l4.5 4.5L5 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
</div>

<style>
  .ink-carousel { display: grid; gap: var(--ink-space-2); }

  .ink-carousel__viewport {
    overflow: hidden;
    border-radius: var(--ink-radius-md);
  }

  .ink-carousel__track {
    display: flex;
    transition: translate var(--ink-duration-base) var(--ink-ease);
  }

  .ink-carousel__track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
  }

  .ink-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ink-space-2);
  }

  .ink-carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-carousel-radius, 50%);
    background: var(--ink-surface);
    color: var(--ink-ink);
    cursor: pointer;
  }

  .ink-carousel__arrow:hover { border-color: var(--ink-ink); }

  .ink-carousel__dots {
    display: flex;
    gap: var(--ink-space-1);
  }

  .ink-carousel__dots > :global(button) {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: none;
    border-radius: var(--ink-carousel-dot-radius, 50%);
    background: var(--ink-border-strong);
    cursor: pointer;
  }

  .ink-carousel__dots > :global(button[aria-current="true"]) {
    background: var(--ink-accent);
  }
</style>

<script>
  function initCarousels(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-ink-carousel]").forEach((car) => {
      if (car.dataset.inkBound) return;
      car.dataset.inkBound = "true";
      const track = car.querySelector<HTMLElement>("[data-ink-carousel-track]");
      const viewport = car.querySelector<HTMLElement>("[data-ink-carousel-viewport]");
      const dotsBox = car.querySelector<HTMLElement>("[data-ink-carousel-dots]");
      const prev = car.querySelector<HTMLElement>("[data-ink-carousel-prev]");
      const next = car.querySelector<HTMLElement>("[data-ink-carousel-next]");
      if (!track || !viewport || !dotsBox || !prev || !next) return;
      const slides = Array.from(track.children) as HTMLElement[];
      slides.forEach((slide, i) => {
        slide.setAttribute("role", "group");
        slide.setAttribute("aria-roledescription", "slide");
        slide.setAttribute("aria-label", `${i + 1} of ${slides.length}`);
      });

      let at = 0;
      const dots: HTMLButtonElement[] = slides.map((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "ink-carousel__dot";
        dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
        dot.addEventListener("click", () => go(i));
        dotsBox.appendChild(dot);
        return dot;
      });

      const go = (i: number) => {
        at = ((i % slides.length) + slides.length) % slides.length;
        track.style.translate = `${-at * 100}%`;
        viewport.dataset.index = String(at);
        dots.forEach((d, di) => {
          if (di === at) d.setAttribute("aria-current", "true");
          else d.removeAttribute("aria-current");
        });
      };

      prev.addEventListener("click", () => go(at - 1));
      next.addEventListener("click", () => go(at + 1));
      car.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          go(at - 1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          go(at + 1);
        }
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let timer: number | undefined;
      if (car.hasAttribute("data-autoplay") && !reduce) {
        const delay = Number(car.dataset.interval ?? 5000);
        const start = () => {
          timer = window.setTimeout(function tick() {
            go(at + 1);
            timer = window.setTimeout(tick, delay);
          }, delay);
        };
        const stop = () => window.clearTimeout(timer);
        car.addEventListener("mouseenter", stop);
        car.addEventListener("mouseleave", start);
        car.addEventListener("focusin", stop);
        car.addEventListener("focusout", start);
        start();
      }

      go(0);
    });
  }

  initCarousels();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = { init: (root?: ParentNode) => { prev?.(root); initCarousels(root ?? document); } };
</script>
