---
interface Props {
  size?: "md" | "lg" | "full";
  style?: string;
  class?: string;
}

const { size = "lg", style, class: className, ...rest } = Astro.props;
---
<div class:list={["ink-container", `ink-container--${size}`, className]} style={style} {...rest}>
  <slot />
</div>

<style>
  .ink-container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--ink-space-4);
  }

  .ink-container--md { max-width: 48rem; }
  .ink-container--lg { max-width: 72rem; }
  .ink-container--full { max-width: none; }
</style>
