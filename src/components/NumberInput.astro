---
import Field from "./Field.astro";

interface Props {
  id: string;
  label: string;
  name?: string;
  min?: number;
  max?: number;
  step?: number;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  placeholder?: string;
  value?: string;
  class?: string;
}

const {
  id, label, name = id, min, max, step, hint, error,
  required = false, disabled = false, placeholder, value, class: className, ...rest
} = Astro.props;

const describedBy = [hint && `${id}-hint`, error && `${id}-error`]
  .filter(Boolean)
  .join(" ") || undefined;
---
<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <input
    id={id}
    name={name}
    type="number"
    inputmode="decimal"
    class="ink-input"
    min={min}
    max={max}
    step={step}
    value={value}
    placeholder={placeholder}
    required={required || undefined}
    disabled={disabled || undefined}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    {...rest}
  />
</Field>
