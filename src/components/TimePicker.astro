---
import Field from "./Field.astro";

interface Props {
  id: string;
  label: string;
  name?: string;
  value?: string;
  hideValue?: boolean;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  id, label, name = id, value, hideValue = false,
  hint, error, required = false, disabled = false,
  class: className, ...rest
} = Astro.props;

function parseTime(v?: string): { hour: string; minute: string } | undefined {
  if (!v) return undefined;
  const m = /^(\d{2}):(\d{2})$/.exec(v);
  if (!m) return undefined;
  const h = Number(m[1]);
  const min = Number(m[2]);
  if (h < 0 || h > 23 || min < 0 || min > 59) return undefined;
  return { hour: m[1], minute: m[2] };
}

const initial = parseTime(value);
const initialValue = initial ? `${initial.hour}:${initial.minute}` : "";
const resolvedPlaceholder = `Select ${label.toLowerCase()}`;
const triggerText = initial ? initialValue : resolvedPlaceholder;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;

const hours = Array.from({ length: 24 }, (_, i) => String(i).padStart(2, "0"));
const minutes = Array.from({ length: 60 }, (_, i) => String(i).padStart(2, "0"));
---
<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <div
    class="ink-timepicker"
    data-ink-timepicker
    data-hour={initial?.hour ?? ""}
    data-minute={initial?.minute ?? ""}
    data-placeholder={resolvedPlaceholder}
  >
    <button
      type="button"
      class="ink-input ink-timepicker__trigger"
      data-ink-time-trigger
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls={`${id}-panel`}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : undefined}
      disabled={disabled || undefined}
      {...rest}
    >
      <span class="ink-visually-hidden">{label}: </span>
      <span class="ink-timepicker__text" data-ink-time-text>{triggerText}</span>
      <svg class="ink-timepicker__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="ink-timepicker__panel" role="dialog" aria-label={`${label} options`} id={`${id}-panel`} data-ink-time-panel hidden>
      <div class="ink-timepicker__columns">
        <div class="ink-timepicker__column">
          <p class="ink-timepicker__column-label" id={`${id}-hour-label`}>Hour</p>
          <ul class="ink-timepicker__list ink-timepicker__list--hour" role="listbox" aria-labelledby={`${id}-hour-label`} data-ink-time-hour tabindex="-1">
            {hours.map((h) => (
              <li
                class="ink-timepicker__option"
                role="option"
                data-val={h}
                aria-selected={initial?.hour === h ? "true" : "false"}
                tabindex={initial ? (initial.hour === h ? "0" : "-1") : (h === "00" ? "0" : "-1")}
              >
                {h}
              </li>
            ))}
          </ul>
        </div>
        <div class="ink-timepicker__column">
          <p class="ink-timepicker__column-label" id={`${id}-minute-label`}>Minute</p>
          <ul class="ink-timepicker__list ink-timepicker__list--minute" role="listbox" aria-labelledby={`${id}-minute-label`} data-ink-time-minute tabindex="-1">
            {minutes.map((m) => (
              <li
                class="ink-timepicker__option"
                role="option"
                data-val={m}
                aria-selected={initial?.minute === m ? "true" : "false"}
                tabindex={initial ? (initial.minute === m ? "0" : "-1") : (m === "00" ? "0" : "-1")}
              >
                {m}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="ink-timepicker__actions">
        <button type="button" class="ink-timepicker__action" data-ink-time-now disabled={disabled || undefined}>
          Now
        </button>
        <button type="button" class="ink-timepicker__action" data-ink-time-clear disabled={disabled || undefined}>
          Clear
        </button>
      </div>
    </div>
    {!hideValue && <input type="hidden" name={name} value={initialValue} data-ink-time-value />}
  </div>
</Field>

<style>
  .ink-timepicker {
    position: relative;
  }

  .ink-timepicker__trigger {
    display: flex;
    align-items: center;
    gap: var(--ink-space-2);
    text-align: start;
    cursor: pointer;
  }

  .ink-timepicker__text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ink-timepicker__chevron {
    flex: none;
    color: var(--ink-muted);
  }

  .ink-timepicker__trigger[aria-expanded="true"] .ink-timepicker__chevron { rotate: 180deg; }

  .ink-timepicker__panel {
    position: absolute;
    top: calc(100% + var(--ink-space-1));
    inset-inline: 0;
    display: grid;
    gap: var(--ink-space-2);
    padding: var(--ink-space-3);
    background: var(--ink-surface);
    border: 1px solid var(--ink-border-strong);
    border-radius: var(--ink-radius-md);
    box-shadow: var(--ink-shadow-2);
    z-index: var(--ink-z-dropdown, 50);
  }

  .ink-timepicker__panel[hidden] { display: none; }

  .ink-timepicker__columns {
    display: flex;
    gap: var(--ink-space-3);
  }

  .ink-timepicker__column {
    display: grid;
    gap: var(--ink-space-1);
    align-content: start;
    min-width: 0;
  }

  .ink-timepicker__column-label {
    margin: 0;
    font-size: var(--ink-text-xs);
    font-weight: var(--ink-font-weight-medium);
    color: var(--ink-muted);
  }

  .ink-timepicker__list {
    list-style: none;
    margin: 0;
    padding: var(--ink-space-1);
    display: grid;
    gap: 2px;
    max-height: 12rem;
    overflow: auto;
    border: 1px solid var(--ink-border);
    border-radius: var(--ink-radius-sm);
  }

  .ink-timepicker__list:focus {
    outline: none;
  }

  .ink-timepicker__list--hour {
    grid-template-columns: repeat(4, minmax(2.75rem, 1fr));
  }

  .ink-timepicker__list--minute {
    grid-template-columns: repeat(6, minmax(2.5rem, 1fr));
  }

  .ink-timepicker__option {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: var(--ink-space-1);
    border-radius: var(--ink-radius-sm);
    font-size: var(--ink-text-sm);
    color: var(--ink-ink);
    cursor: pointer;
  }

  .ink-timepicker__option:hover {
    background: color-mix(in srgb, var(--ink-accent) 10%, transparent);
  }

  .ink-timepicker__option:focus-visible {
    outline: 2px solid var(--ink-focus-color);
    outline-offset: -2px;
  }

  .ink-timepicker__option[aria-selected="true"] {
    background: var(--ink-accent);
    color: var(--ink-accent-ink);
    font-weight: var(--ink-font-weight-semibold);
  }

  .ink-timepicker__actions {
    display: flex;
    gap: var(--ink-space-1);
  }

  .ink-timepicker__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: var(--ink-space-1) var(--ink-space-3);
    border: 1px solid transparent;
    border-radius: var(--ink-radius-sm);
    background: transparent;
    color: var(--ink-ink);
    font-size: var(--ink-text-sm);
    cursor: pointer;
  }

  .ink-timepicker__action:hover {
    background: color-mix(in srgb, var(--ink-ink) 8%, transparent);
  }

  .ink-timepicker__action:focus-visible {
    outline: 2px solid var(--ink-focus-color);
    outline-offset: 2px;
  }

  .ink-timepicker__action:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>

<script>
  const HOUR_COLS = 4;
  const MINUTE_COLS = 6;

  function initTimePickers(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>("[data-ink-timepicker]").forEach((box) => {
      if (box.dataset.inkBound) return;
      box.dataset.inkBound = "true";
      const trigger = box.querySelector<HTMLButtonElement>("[data-ink-time-trigger]");
      const panel = box.querySelector<HTMLElement>("[data-ink-time-panel]");
      const text = box.querySelector<HTMLElement>("[data-ink-time-text]");
      const hidden = box.querySelector<HTMLInputElement>("[data-ink-time-value]");
      const hourList = box.querySelector<HTMLElement>("[data-ink-time-hour]");
      const minuteList = box.querySelector<HTMLElement>("[data-ink-time-minute]");
      const nowBtn = box.querySelector<HTMLButtonElement>("[data-ink-time-now]");
      const clearBtn = box.querySelector<HTMLButtonElement>("[data-ink-time-clear]");
      if (!trigger || !panel || !text || !hourList || !minuteList) return;
      const placeholder = box.dataset.placeholder ?? "";

      let hour: string | null = box.dataset.hour || null;
      let minute: string | null = box.dataset.minute || null;

      const COLS = new Map<HTMLElement, number>([
        [hourList, HOUR_COLS],
        [minuteList, MINUTE_COLS],
      ]);

      const optionsOf = (list: HTMLElement): HTMLElement[] =>
        Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));

      const paint = () => {
        for (const [list, val] of [[hourList, hour], [minuteList, minute]] as Array<[HTMLElement, string | null]>) {
          for (const o of optionsOf(list)) {
            o.setAttribute("aria-selected", String(o.dataset.val === val));
          }
        }
      };

      // Roving tabindex per column: exactly one tabbable option each.
      const setRoving = (list: HTMLElement, target: HTMLElement | null) => {
        for (const o of optionsOf(list)) o.tabIndex = o === target ? 0 : -1;
      };

      const focusVal = (list: HTMLElement, val: string) => {
        const el = optionsOf(list).find((o) => o.dataset.val === val) ?? null;
        setRoving(list, el);
        el?.focus();
      };

      const isOpen = () => !panel.hidden;
      const open = () => {
        if (trigger.disabled) return;
        panel.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        focusVal(hourList, hour ?? "00");
      };
      const close = () => {
        panel.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
      };

      const commit = () => {
        if (hour == null || minute == null) return;
        const v = `${hour}:${minute}`;
        if (hidden) hidden.value = v;
        text.textContent = v;
        close();
        trigger.focus();
        box.dispatchEvent(new CustomEvent("ink:time:change", {
          bubbles: true,
          detail: { value: v },
        }));
      };

      const activate = (list: HTMLElement, val: string) => {
        if (list === hourList) hour = val;
        else minute = val;
        paint();
        // Both parts set: commit live (a later change to either part
        // recommits immediately), then close and refocus the trigger.
        if (hour != null && minute != null) commit();
      };

      const onListClick = (list: HTMLElement) => (event: Event) => {
        const el = (event.target as HTMLElement).closest?.('[role="option"]');
        if (!(el instanceof HTMLElement)) return;
        event.stopPropagation();
        activate(list, el.dataset.val ?? "");
        focusVal(list, el.dataset.val ?? "");
      };
      hourList.addEventListener("click", onListClick(hourList));
      minuteList.addEventListener("click", onListClick(minuteList));

      const onListKey = (list: HTMLElement) => (event: KeyboardEvent) => {
        const target = event.target;
        if (!(target instanceof HTMLElement) || target.getAttribute("role") !== "option") return;
        const cols = COLS.get(list) ?? 1;
        const opts = optionsOf(list);
        const at = opts.indexOf(target);
        const move = (delta: number) => {
          event.preventDefault();
          const to = Math.min(opts.length - 1, Math.max(0, (at < 0 ? 0 : at) + delta));
          setRoving(list, opts[to]);
          opts[to]?.focus();
        };
        if (event.key === "ArrowLeft") move(-1);
        else if (event.key === "ArrowRight") move(1);
        else if (event.key === "ArrowUp") move(-cols);
        else if (event.key === "ArrowDown") move(cols);
        else if (event.key === "Home") { event.preventDefault(); setRoving(list, opts[0]); opts[0]?.focus(); }
        else if (event.key === "End") {
          event.preventDefault();
          setRoving(list, opts[opts.length - 1]);
          opts[opts.length - 1]?.focus();
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          activate(list, target.dataset.val ?? "");
          focusVal(list, target.dataset.val ?? "");
        } else if (event.key === "Escape") {
          event.preventDefault();
          close();
          trigger.focus();
        }
      };
      hourList.addEventListener("keydown", onListKey(hourList));
      minuteList.addEventListener("keydown", onListKey(minuteList));

      nowBtn?.addEventListener("click", () => {
        const now = new Date();
        hour = String(now.getHours()).padStart(2, "0");
        minute = String(now.getMinutes()).padStart(2, "0");
        paint();
        commit();
      });

      clearBtn?.addEventListener("click", () => {
        hour = null;
        minute = null;
        if (hidden) hidden.value = "";
        text.textContent = placeholder;
        paint();
        setRoving(hourList, optionsOf(hourList)[0]);
        setRoving(minuteList, optionsOf(minuteList)[0]);
        box.dispatchEvent(new CustomEvent("ink:time:change", {
          bubbles: true,
          detail: { value: "" },
        }));
      });

      panel.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape" && isOpen()) {
          event.preventDefault();
          close();
          trigger.focus();
        }
      });

      trigger.addEventListener("click", () => {
        if (isOpen()) close();
        else open();
      });
      trigger.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "ArrowDown" && !isOpen()) {
          event.preventDefault();
          open();
        } else if (event.key === "Escape" && isOpen()) {
          event.preventDefault();
          close();
        }
      });

      document.addEventListener("click", (event: Event) => {
        if (!box.contains(event.target as Node)) close();
      });

      paint();
    });
  }

  initTimePickers();

  const w = window as unknown as { Ink?: { init: (root?: ParentNode) => void } };
  const prev = w.Ink?.init;
  w.Ink = { init: (root?: ParentNode) => { prev?.(root); initTimePickers(root ?? document); } };
</script>
