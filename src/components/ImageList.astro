---
interface Props {
  cols?: number;
  gap?: "sm" | "md" | "lg";
  rowHeight?: string;
  label?: string;
  class?: string;
}

const { cols = 3, gap = "md", rowHeight = "10rem", label, class: className, ...rest } = Astro.props;
const gaps = { sm: "var(--ink-space-2)", md: "var(--ink-space-4)", lg: "var(--ink-space-6)" } as const;
---
<ul
  class:list={["ink-imagelist", className]}
  style={`--ink-imagelist-cols: ${cols}; --ink-imagelist-gap: ${gaps[gap]}; --ink-imagelist-row: ${rowHeight};`}
  aria-label={label}
  {...rest}
>
  <slot />
</ul>

<style>
  .ink-imagelist {
    display: grid;
    grid-template-columns: repeat(var(--ink-imagelist-cols, 3), 1fr);
    grid-auto-rows: var(--ink-imagelist-row, 10rem);
    gap: var(--ink-imagelist-gap, var(--ink-space-4));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ink-imagelist > :global(li) {
    overflow: hidden;
    border-radius: var(--ink-radius-md);
    background: color-mix(in srgb, var(--ink-ink) 5%, var(--ink-bg));
  }

  .ink-imagelist > :global(li > *) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
