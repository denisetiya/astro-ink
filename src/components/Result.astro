---
interface Props {
  status: "success" | "error" | "info";
  title: string;
  body?: string;
  class?: string;
}

const { status, title, body, class: className, ...rest } = Astro.props;
---
<div class:list={["ink-result", `ink-result--${status}`, className]} {...rest}>
  <span class="ink-result__glyph" aria-hidden="true">
    {status === "success" && (
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2.5" />
        <path d="M13 20.5l5 5 9-11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    {status === "error" && (
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2.5" />
        <path d="M15 15l10 10M25 15l-10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      </svg>
    )}
    {status === "info" && (
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2.5" />
        <path d="M20 18v9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="20" cy="13" r="1.5" fill="currentColor" />
      </svg>
    )}
  </span>
  <h2 class="ink-result__title">{title}</h2>
  {body && <p class="ink-result__body">{body}</p>}
  <div class="ink-result__actions"><slot /></div>
</div>

<style>
  .ink-result {
    display: grid;
    justify-items: center;
    gap: var(--ink-space-2);
    padding: var(--ink-space-7) var(--ink-space-4);
    text-align: center;
  }

  .ink-result__glyph { display: inline-flex; }

  .ink-result--success .ink-result__glyph { color: var(--ink-success); }
  .ink-result--error .ink-result__glyph { color: var(--ink-danger); }
  .ink-result--info .ink-result__glyph { color: var(--ink-info); }

  .ink-result__title {
    font-size: var(--ink-text-xl);
    font-weight: var(--ink-font-weight-semibold);
  }

  .ink-result__body {
    font-size: var(--ink-text-sm);
    color: var(--ink-muted);
    max-width: 46ch;
  }

  .ink-result__actions {
    display: flex;
    gap: var(--ink-space-2);
    margin-top: var(--ink-space-2);
  }
</style>
