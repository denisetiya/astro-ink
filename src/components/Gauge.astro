---
import { gaugeAngle } from "../scripts/chart";

interface Props {
  value: number;
  min?: number;
  max?: number;
  label?: string;
  size?: number;
  class?: string;
}

const {
  value,
  min = 0,
  max = 100,
  label = "Gauge",
  size = 200,
  class: className,
  ...rest
} = Astro.props;

const valid = max > min;
const displayed = valid ? Math.min(max, Math.max(min, value)) : min;
const angle = gaugeAngle(value, min, max);
const pct = (angle / 180) * 100;

const strokeW = 14;
const pad = strokeW / 2 + 2;
const r = Math.max(1, size / 2 - pad);
const cx = size / 2;
const cy = size / 2;
const arc = `M${(cx - r).toFixed(2)},${cy} A${r.toFixed(2)},${r.toFixed(2)} 0 0 1 ${(cx + r).toFixed(2)},${cy}`;
const viewH = cy + pad;

const centerLabel = min === 0 && max === 100 ? `${displayed}%` : `${displayed}`;
---
<div
  class:list={["ink-gauge", className]}
  role="meter"
  aria-valuemin={min}
  aria-valuemax={max}
  aria-valuenow={displayed}
  aria-label={label}
  {...rest}
>
  <svg class="ink-gauge__svg" viewBox={`0 0 ${size} ${viewH}`} aria-hidden="true">
    <path class="ink-gauge__track" d={arc} pathLength={100} />
    <path class="ink-gauge__fill" d={arc} pathLength={100} stroke-dasharray={`${pct} 100`} />
    <text class="ink-gauge__value" x={cx} y={cy - 10} text-anchor="middle">{centerLabel}</text>
  </svg>
</div>

<style>
  .ink-gauge {
    --ink-gauge-track: var(--ink-border);
    --ink-gauge-fill: var(--ink-accent);
    --ink-gauge-value: var(--ink-ink);
  }

  .ink-gauge__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: inherit;
  }

  .ink-gauge__track,
  .ink-gauge__fill {
    fill: none;
    stroke-width: 14;
  }

  .ink-gauge__track {
    stroke: var(--ink-gauge-track);
  }

  .ink-gauge__fill {
    stroke: var(--ink-gauge-fill);
    stroke-linecap: round;
  }

  .ink-gauge__value {
    fill: var(--ink-gauge-value);
    font-size: var(--ink-text-2xl);
    font-weight: var(--ink-font-weight-semibold);
  }
</style>
