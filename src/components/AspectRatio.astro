---
interface Props {
  ratio?: string;
  class?: string;
}

const { ratio = "16 / 9", class: className, ...rest } = Astro.props;
---
<div class:list={["ink-ratio", className]} style={`aspect-ratio: ${ratio};`} {...rest}>
  <slot />
</div>

<style>
  .ink-ratio {
    overflow: hidden;
    border-radius: var(--ink-radius-md);
    background: color-mix(in srgb, var(--ink-ink) 5%, var(--ink-bg));
  }

  .ink-ratio > :global(*) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
